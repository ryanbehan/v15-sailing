{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "v15-sailing",
  "main": "deployment/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "preview_urls": true,
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "routes": [
    { "pattern": "v-15.org/*", "zone_name": "v-15.org" },
    { "pattern": "www.v-15.org/*", "zone_name": "v-15.org" },
    { "pattern": "dev.v-15.org", "custom_domain": true }
  ]
}
